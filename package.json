{
  "name": "@tevm/guillotine-mini",
  "version": "0.1.0",
  "description": "Minimal, correct, and well-tested Ethereum Virtual Machine (EVM) implementation in Zig",
  "type": "module",
  "scripts": {
    "build": "zig build",
    "test": "zig build test --summary all",
    "genesis": "bun scripts/genesis.ts",
    "test:isolate": "bun scripts/isolate-test.ts",
    "test:subset": "bun scripts/test-subset.ts",
    "fix:specs": "bun scripts/fix-specs.ts",
    "test:client": "bun --cwd client-ts run test"
  },
  "files": [
    "build.zig",
    "build.zig.zon",
    "src/**/*.zig",
    "docs",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "rust-toolchain.toml"
  ],
  "keywords": [
    "ethereum",
    "evm",
    "virtual-machine",
    "blockchain",
    "zig"
  ],
  "author": "William Cory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evmts/guillotine-mini.git"
  },
  "homepage": "https://guillotine-mini.tevm.sh",
  "bugs": {
    "url": "https://github.com/evmts/guillotine-mini/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.4.2",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.32.1",
    "@types/bun": "latest",
    "fzstd": "^0.1.1",
    "typescript": "^5.3.0"
  }
}
