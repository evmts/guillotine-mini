{
  "name": "@tevm/guillotine-mini",
  "version": "0.2.0",
  "description": "Minimal, formally verified Ethereum Virtual Machine (EVM) in Zig with universal zero-dependency TypeScript/WASM SDK",
  "type": "module",
  "main": "./ts/index.ts",
  "types": "./ts/index.ts",
  "exports": {
    ".": {
      "types": "./ts/index.ts",
      "import": "./ts/index.ts",
      "default": "./ts/index.ts"
    },
    "./evm": {
      "types": "./ts/evm.ts",
      "import": "./ts/evm.ts",
      "default": "./ts/evm.ts"
    },
    "./abi": {
      "types": "./ts/abi.ts",
      "import": "./ts/abi.ts",
      "default": "./ts/abi.ts"
    },
    "./wasi-shim": {
      "types": "./ts/wasi-shim.ts",
      "import": "./ts/wasi-shim.ts",
      "default": "./ts/wasi-shim.ts"
    },
    "./precompiles": {
      "types": "./ts/precompiles.ts",
      "import": "./ts/precompiles.ts",
      "default": "./ts/precompiles.ts"
    },
    "./fork": {
      "types": "./ts/fork.ts",
      "import": "./ts/fork.ts",
      "default": "./ts/fork.ts"
    },
    "./wasm": "./zig-out/bin/guillotine_mini.wasm",
    "./wasm/core": "./zig-out/bin/guillotine_mini_core.wasm",
    "./wasm/precompiles.mjs": "./wasm/precompiles.mjs",
    "./wasm/*": "./zig-out/bin/*",
    "./package.json": "./package.json"
  },
  "files": [
    "ts/*.ts",
    "!ts/*.test.ts",
    "!ts/PACKAGE.ts",
    "wasm/precompiles.mjs",
    "include/guillotine_mini.h",
    "zig-out/bin/*.wasm",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "genesis": "bun scripts/genesis.ts",
    "test:isolate": "bun scripts/isolate-test.ts",
    "test:subset": "bun scripts/test-subset.ts",
    "fix:specs": "bun scripts/fix-specs.ts",
    "test": "bun test ./ts/",
    "bench:wasm": "node bench/wasm-compare.mjs",
    "smithers:ci": "bun .smithers/scripts/run-trusted-ci.ts ci '//...'",
    "smithers:ci:untrusted": "bun .smithers/scripts/run-trusted-ci.ts --untrusted ci '//...'",
    "smithers:audit": "bun .smithers/scripts/generate-audit-report.ts",
    "smithers:audit:docs": "bun .smithers/scripts/generate-audit-report.ts --publish-docs",
    "smithers:wiki:check": "bun .smithers/scripts/sync-wiki-feed.ts --check",
    "smithers:home:write": "bun .smithers/scripts/project-home.ts --write",
    "smithers:auth": "bun .smithers/scripts/mint-sandbox-auth.ts"
  },
  "keywords": [
    "ethereum",
    "evm",
    "wasm",
    "wasi",
    "evmc",
    "virtual-machine",
    "blockchain",
    "cloudflare-workers",
    "zig",
    "tevm"
  ],
  "author": "William Cory",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/evmts/guillotine-mini.git"
  },
  "homepage": "https://mini.tevm.sh",
  "bugs": {
    "url": "https://github.com/evmts/guillotine-mini/issues"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.12.0",
    "@types/bun": "latest",
    "fzstd": "^0.1.1",
    "typescript": "^5.9.3"
  }
}
