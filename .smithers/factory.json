  "on": [
    {
      "event": "issue.labeled:todo",
      "flow": "issue/poc",
      "description": "Build a failing regression and bounded PoC for every maintainer-accepted TODO"
    },
    {
      "event": "change.opened",
      "flow": "checks/review",
      "description": "Review every Change for execution-specs parity, gas, memory safety, and ABI stability"
    },
    {
      "event": "change.updated",
      "flow": "checks/review",
      "description": "Re-review every updated Change"
    },
    {
      "event": "change.landed",
      "flow": [
        "wiki-refresh",
        "audit-report",
        "docs-publish"
      ],
      "description": "Refresh the wiki, Mythical History, Lighthouse audit report, and docs after landing"
    },
    {
      "event": "github.push:main",
      "flow": [
        "wiki-refresh",
        "audit-report"
      ],
      "description": "Refresh wiki and Lighthouse audit report after pushes to main"
    },
    {
      "event": "schedule:0 3 * * *",
      "flow": "audit-report",
      "description": "Run nightly Lighthouse backpressure audit on main"
    }
  ],
  "github": {
    "mirror": "push",
    "issues": "two-way",
    "changes": "land",
    "protectedPaths": [
      "src/evm.zig",
      "src/frame.zig",
      "src/instructions",
      "src/precompiles",
      "src/root_c.zig",
      "build.zig",
      "build.zig.zon",
      "native-dependencies.json",
      ".smithers",
      ".github",
      ".agents/uphill",
      "PACKAGE.ts",
      "AGENTS.md",
      "CLAUDE.md"
    ],
    "maintainers": [
      "roninjin10",
      "fucory"
    ],
    "dailyTokens": 1000000000
  },
  "policy": {
